# Dimension a sketch with the Dimension tool: a diameter, two lengths, a distance between
# points, an angle, and a redundant length that becomes a reference dimension.
# Run: cargo run -p anvil-app --bin anvilcad-agent -- --script docs/agent/sketch-dimensions.jsonl
{"cmd":"click","label":"Front Plane"}
{"cmd":"click","label":"Sketch"}
{"cmd":"click","label":"Sketch","index":1}
{"cmd":"click","label":"Rectangle"}
{"cmd":"click","sketch":[-20,-10]}
{"cmd":"click","sketch":[20,10]}
{"cmd":"click","label":"Circle"}
{"cmd":"click","sketch":[0,0]}
{"cmd":"click","sketch":[5,0]}
{"cmd":"click","label":"Line"}
{"cmd":"click","sketch":[30,-10]}
{"cmd":"click","sketch":[40,5]}
{"cmd":"key","key":"Escape"}
{"cmd":"click","label":"Dimension"}
# The circle, placed up and to the right: its diameter.
{"cmd":"click","sketch":[5,0]}
{"cmd":"click","sketch":[12,8]}
# The bottom edge, placed below it: its length.
{"cmd":"click","sketch":[-8,-10]}
{"cmd":"click","sketch":[-8,-17]}
# The right edge, placed to its right.
{"cmd":"click","sketch":[20,4]}
{"cmd":"click","sketch":[25,4]}
# The origin and the top-left corner, placed above them: the horizontal distance.
{"cmd":"click","sketch":[0,0]}
{"cmd":"click","sketch":[-20,10]}
{"cmd":"click","sketch":[-10,15]}
# The bottom edge and the slanted line, placed between them: the angle where they meet.
{"cmd":"click","sketch":[10,-10]}
{"cmd":"click","sketch":[35,-2.5]}
{"cmd":"click","sketch":[42,-7]}
# The top edge is already as long as the bottom one, so this over-defines the sketch.
{"cmd":"click","sketch":[8,10]}
{"cmd":"click","sketch":[8,16]}
{"cmd":"state","id":"prompt"}
{"cmd":"click","label":"Make Reference"}
{"cmd":"state","id":"result"}
{"cmd":"screenshot","path":"target/agent/sketch-dimensions.png"}
