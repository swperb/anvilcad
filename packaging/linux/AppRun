#!/bin/sh
# AppImage entry point. With no tool name it starts the AnvilCAD window; the command-line
# tools bundled with it run as `AnvilCAD.AppImage anvilcad-agent ...` or
# `AnvilCAD.AppImage anvil-bulk ...`.
HERE="$(dirname "$(readlink -f "$0")")"
case "$1" in
  anvilcad-agent|anvil-bulk)
    tool="$1"
    shift
    exec "$HERE/usr/bin/$tool" "$@"
    ;;
esac
exec "$HERE/usr/bin/anvilcad" "$@"
